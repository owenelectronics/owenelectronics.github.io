---
import Base from '../layouts/Base.astro';
import { links, type Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const home = t.lang === 'es' ? '/' : '/en/';
const marquee = [...t.marquee, ...t.marquee];
const wipIds = ['agentic'];
---

<Base lang={t.lang} title={t.meta.title} description={t.meta.description}>
  <a class="skip" href="#contenido">{t.a11y.skip}</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href={home}>
        <span class="mono" aria-hidden="true">OC</span>
        <span>Owen Caminos</span>
      </a>
      <nav class="nav-links" aria-label={t.a11y.menu}>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#metodo">{t.nav.method}</a>
        <a href="#experiencia">{t.nav.experience}</a>
        <a href="#skills">{t.nav.skills}</a>
      </nav>
      <div class="nav-end">
        <a class="lang" href={t.otherLang.href} title={t.otherLang.title} hreflang={t.otherLang.label.toLowerCase()}>
          {t.otherLang.label}
        </a>
        <a class="btn primary small" href="#contacto">{t.nav.contact}</a>
      </div>
    </div>
  </header>

  <main id="contenido">
    <!-- Hero -->
    <div class="hero">
      <div class="hero-bg" aria-hidden="true">
        <div class="glow a"></div>
        <div class="glow b"></div>
      </div>
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="hero-id reveal">
              <span class="avatar"><img src="/img/owen.webp" alt={t.a11y.photo} width="320" height="320" /></span>
              <span class="badge"><i class="dot"></i>{t.hero.badge}</span>
            </div>
            <h1 class="reveal" style="--i:1">{t.hero.name}</h1>
            <p class="hero-lead reveal" style="--i:2">
              {t.hero.lead}
              <span class="rot-line">
                {t.hero.rotatingPrefix}{' '}
                <span class="rot" data-words={JSON.stringify(t.hero.rotating)}>{t.hero.rotating[0]}</span><span
                  class="caret"
                  aria-hidden="true"></span>
              </span>
            </p>
            <p class="hero-intro reveal" style="--i:3">{t.hero.intro}</p>
            <div class="hero-cta reveal" style="--i:4">
              <a class="btn primary" href="#proyectos">
                {t.hero.ctaProjects}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
              <a class="btn" href={links.cv} download>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path></svg>
                {t.hero.ctaCv}
              </a>
            </div>
            <div class="socials reveal" style="--i:5">
              <a href={links.github} target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path></svg>
              </a>
              <a href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3v-11zm6.5 0h3.8v1.5h.06c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76v5.69h-4v-5.04c0-1.2-.02-2.75-1.78-2.75-1.78 0-2.05 1.31-2.05 2.66v5.13h-4v-11z"></path></svg>
              </a>
              <a href={`mailto:${links.email}`} aria-label="Email">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="M3.5 7.5l8.5 6 8.5-6"></path></svg>
              </a>
            </div>
          </div>

          <div class="reveal" style="--i:3">
            <div class="term" role="img" aria-label={t.hero.terminalTitle}>
              <div class="term-bar"><i></i><i></i><i></i><span>{t.hero.terminalTitle}</span></div>
              <div class="term-body" data-term data-command={t.hero.terminal.command}>
                <div class="t-line t-cmd"><span class="t-prompt">$</span><span class="t-text" data-typed></span></div>
                {
                  t.hero.terminal.steps.map((s) => (
                    <div class="t-line t-step">
                      <span class="t-arrow">›</span>
                      <span class="t-text">{s.text}</span>
                      <span class="t-spin">◠</span>
                      <span class="t-res">✓ {s.result}</span>
                    </div>
                  ))
                }
                <div class="t-line t-sum">✓ {t.hero.terminal.summary}</div>
                <div class="t-line t-final"><span class="t-arrow">›</span><span class="t-text">{t.hero.terminal.final}</span></div>
              </div>
            </div>
          </div>
        </div>

        <div class="stats reveal">
          {
            t.stats.map((s) => (
              <div class="stat">
                <b data-count={s.value} data-suffix={s.suffix}>
                  {s.value}
                  {s.suffix}
                </b>
                <span>{s.label}</span>
              </div>
            ))
          }
        </div>

        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {marquee.map((m) => <span class="chip">{m}</span>)}
          </div>
        </div>
      </div>
    </div>

    <!-- Qué hago -->
    <section id="que-hago">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.pillars.kicker}</div>
          <h2>{t.pillars.title}</h2>
        </div>
        <div class="pillars">
          {
            t.pillars.items.map((p, i) => (
              <article class="pillar reveal" style={`--i:${i}`} data-spot>
                <div class="pillar-ico" aria-hidden="true">
                  {p.icon === 'analysis' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4h8l4 4v12H4V4h4zM8 12h8M8 16h5M8 8h3" /></svg>
                  )}
                  {p.icon === 'qa' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.800-1.200-8-4.500-8-9V6l8-3z" /><path d="M8.500 12l2.500 2.500 4.500-5" /></svg>
                  )}
                  {p.icon === 'ai' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><circle cx="5" cy="5" r="2" /><circle cx="19" cy="5" r="2" /><circle cx="5" cy="19" r="2" /><circle cx="19" cy="19" r="2" /><path d="M6.500 6.500l3.300 3.300M17.500 6.500l-3.300 3.300M6.500 17.500l3.300-3.300M17.500 17.500l-3.300-3.300" /></svg>
                  )}
                </div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <section id="proyectos">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.projects.kicker}</div>
          <h2>{t.projects.title}</h2>
        </div>

        {
          t.projects.items.map((p) => {
            const item = p as any;
            return (
              <article class="project" id={p.id}>
                <div class="p-media reveal">
                  <div class="frame" data-tilt>
                    <div class="frame-bar" aria-hidden="true">
                      <i /><i /><i />
                      <em>{p.title}</em>
                    </div>
                    {p.kind === 'pipeline' ? (
                      <div class="pipe" aria-hidden="true">
                        <div class="pipe-row">
                          {item.pipeline.map((n: string, i: number) => (
                            <div class="pipe-node" style={`--n:${i}`}>
                              <i>{i + 1}</i>
                              {n}
                            </div>
                          ))}
                        </div>
                        <div class="pipe-code">
                          {item.code.map((l: string[]) => (
                            <div>
                              {l[0] !== "Scenario:" && <Fragment set:html="&nbsp;&nbsp;" />}
                              <b>{l[0]}</b> {l[1]} {l[2] && <span>✓</span>}
                            </div>
                          ))}
                        </div>
                      </div>
                    ) : (
                      <div class="shots" data-shots>
                        {p.images.map((img, i) => (
                          <img
                            src={img.src}
                            alt={img.alt}
                            class={i === 0 ? 'on' : ''}
                            loading="lazy"
                            decoding="async"
                            width="1280"
                            height="800"
                          />
                        ))}
                      </div>
                    )}
                  </div>
                  {p.images.length > 1 && (
                    <div class="dots" data-dots>
                      {p.images.map((img, i) => (
                        <button type="button" class={i === 0 ? 'on' : ''} aria-label={`${t.a11y.gallery} ${i + 1}: ${img.alt}`} />
                      ))}
                    </div>
                  )}
                </div>

                <div class="p-body reveal" style="--i:1">
                  <span class={`p-status ${wipIds.includes(p.id) ? 'wip' : ''}`}>
                    <i class="dot" />
                    {p.status}
                  </span>
                  <h3>{p.title}</h3>
                  <p class="p-sub">{p.subtitle}</p>
                  <p class="p-sum">{p.summary}</p>
                  <p class="p-role">
                    <b>{t.projects.roleLabel}:</b> {p.role}
                  </p>
                  <ul class="ticks">
                    {p.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                  <div class="chips">
                    {p.stack.map((s) => <span class="chip">{s}</span>)}
                  </div>
                  {p.links.length > 0 && (
                    <div class="p-links">
                      {p.links.map((l: any) => (
                        <a class={`btn ${l.primary ? 'primary' : ''}`} href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                          {l.label}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }

        <h3 class="more-title reveal">{t.projects.moreTitle}</h3>
        <div class="more">
          {
            t.projects.more.map((m, i) => (
              <article class="more-card reveal" style={`--i:${i}`}>
                <small>{m.tag}</small>
                <h4>{m.title}</h4>
                <p>{m.text}</p>
                <div class="chips">
                  {m.stack.map((s) => <span class="chip">{s}</span>)}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Cómo trabajo -->
    <section id="metodo" class="method">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.method.kicker}</div>
          <h2>{t.method.title}</h2>
          <p>{t.method.intro}</p>
        </div>
        <div class="steps-wrap" data-steps>
          <div class="steps-line" aria-hidden="true"><i></i></div>
          <ol class="steps">
          {
            t.method.steps.map((s) => (
              <li class="step">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
          </ol>
        </div>
      </div>
    </section>

    <!-- Experiencia -->
    <section id="experiencia">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.experience.kicker}</div>
          <h2>{t.experience.title}</h2>
        </div>
        <div class="timeline">
          {
            t.experience.items.map((j, i) => (
              <article class="job reveal" style={`--i:${i}`}>
                <div class="job-top">
                  <h3>{j.role}</h3>
                  <time>{j.period}</time>
                </div>
                <p class="job-co">{j.company}</p>
                <p class="job-text">{j.text}</p>
                <ul class="ticks">
                  {j.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="method">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="kicker">{t.skills.kicker}</div>
          <h2>{t.skills.title}</h2>
        </div>
        <div class="skills">
          {
            t.skills.groups.map((g, i) => (
              <article class="skill reveal" style={`--i:${i % 3}`}>
                <h3>{g.title}</h3>
                <div class="chips">
                  {g.items.map((s) => <span class="chip">{s}</span>)}
                </div>
              </article>
            ))
          }
        </div>
        <div class="edu">
          <div class="edu-box reveal">
            <h3>{t.skills.educationTitle}</h3>
            <ul>
              {
                t.skills.education.map((e) => (
                  <li>
                    <div>
                      {e.title}
                      <span>{e.place}</span>
                    </div>
                    <time>{e.when}</time>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="edu-box reveal" style="--i:1">
            <h3>{t.skills.languagesTitle}</h3>
            <p style="color:var(--muted)">{t.skills.languages}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto">
      <div class="wrap">
        <div class="contact-card reveal">
          <div class="kicker">{t.contact.kicker}</div>
          <h2>{t.contact.title}</h2>
          <p>{t.contact.text}</p>
          <div class="contact-actions">
            <a class="btn primary" href={`mailto:${links.email}`}>{t.contact.emailCta}</a>
            <button class="btn" type="button" data-copy={links.email} data-copied={t.contact.copied}>{t.contact.copy}</button>
            <a class="btn" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <a class="btn" href={links.cv} download>{t.contact.cv}</a>
          </div>
          <div class="mail">{links.email}</div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span>© {new Date().getFullYear()} Owen Caminos Dolhartz</span>
      <span>{t.footer}</span>
    </div>
  </footer>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $$ = <T extends Element>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel));

    // Aparición de los bloques al entrar en pantalla
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    $$('.reveal').forEach((el) => io.observe(el));

    // Barra de progreso, borde de la navegación y línea de pasos
    const bar = document.querySelector<HTMLElement>('.progress');
    const nav = document.querySelector<HTMLElement>('.nav');
    const steps = document.querySelector<HTMLElement>('[data-steps]');
    const stepItems = steps ? $$<HTMLElement>('.step', steps) : [];
    const stepLine = steps?.querySelector<HTMLElement>('.steps-line i');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      nav?.classList.toggle('scrolled', scrollY > 8);
      if (steps) {
        const r = steps.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight * 0.72 - r.top) / r.height));
        if (stepLine) stepLine.style.transform = matchMedia('(max-width: 980px)').matches ? `scaleY(${p.toFixed(3)})` : `scaleX(${p.toFixed(3)})`;
        stepItems.forEach((s, i) => s.classList.toggle('lit', p >= i / Math.max(1, stepItems.length - 1) - 0.02));
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();

    // Sección activa en el menú
    const navLinks = $$<HTMLAnchorElement>('.nav-links a');
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            navLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${e.target.id}`));
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    navLinks.forEach((a) => {
      const target = document.querySelector(a.getAttribute('href') ?? '');
      if (target) spy.observe(target);
    });

    // Contadores
    const countIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          countIO.unobserve(e.target);
          const el = e.target as HTMLElement;
          const end = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? '';
          if (reduce) continue;
          const t0 = performance.now();
          const dur = 1400;
          const tick = (now: number) => {
            const k = Math.min(1, (now - t0) / dur);
            const eased = 1 - Math.pow(1 - k, 3);
            el.textContent = Math.round(end * eased) + suffix;
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    $$('[data-count]').forEach((el) => countIO.observe(el));

    // Palabras que se escriben en el titular
    const rot = document.querySelector<HTMLElement>('.rot');
    if (rot && !reduce) {
      const words: string[] = JSON.parse(rot.dataset.words ?? '[]');
      let w = 0;
      let c = words[0]?.length ?? 0;
      let deleting = true;
      const step = () => {
        const word = words[w];
        c += deleting ? -1 : 1;
        rot.textContent = word.slice(0, c);
        let wait = deleting ? 38 : 72;
        if (!deleting && c === word.length) {
          deleting = true;
          wait = 2100;
        } else if (deleting && c === 0) {
          deleting = false;
          w = (w + 1) % words.length;
          wait = 320;
        }
        setTimeout(step, wait);
      };
      if (words.length > 1) setTimeout(step, 2400);
    }

    // Terminal: el flujo corre solo y vuelve a empezar
    const term = document.querySelector<HTMLElement>('[data-term]');
    if (term) {
      const typed = term.querySelector<HTMLElement>('[data-typed]')!;
      const command = term.dataset.command ?? '';
      const lines = $$<HTMLElement>('.t-line', term);
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      if (reduce) {
        typed.textContent = command;
        lines.forEach((l) => l.classList.add('on', 'done'));
      } else {
        const run = async () => {
          for (;;) {
            lines.forEach((l) => l.classList.remove('on', 'done'));
            typed.textContent = '';
            await sleep(500);
            lines[0].classList.add('on');
            for (const ch of command) {
              typed.textContent += ch;
              await sleep(34);
            }
            await sleep(450);
            for (const line of lines.slice(1)) {
              line.classList.add('on');
              if (line.classList.contains('t-step')) {
                await sleep(850);
                line.classList.add('done');
                await sleep(220);
              } else {
                await sleep(520);
              }
            }
            await sleep(5200);
          }
        };
        run();
      }
    }

    // Galerías de capturas
    $$<HTMLElement>('.p-media').forEach((media) => {
      const imgs = $$<HTMLImageElement>('[data-shots] img', media);
      const dots = $$<HTMLButtonElement>('[data-dots] button', media);
      if (imgs.length < 2) return;
      let i = 0;
      let timer: number | undefined;
      const show = (n: number) => {
        i = (n + imgs.length) % imgs.length;
        imgs.forEach((im, k) => im.classList.toggle('on', k === i));
        dots.forEach((d, k) => d.classList.toggle('on', k === i));
      };
      const start = () => {
        if (reduce || timer) return;
        timer = window.setInterval(() => show(i + 1), 3800);
      };
      const stop = () => {
        clearInterval(timer);
        timer = undefined;
      };
      dots.forEach((d, k) =>
        d.addEventListener('click', () => {
          stop();
          show(k);
        }),
      );
      media.addEventListener('mouseenter', stop);
      media.addEventListener('mouseleave', start);
      new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.3 }).observe(media);
    });

    // Inclinación suave de las capturas y brillo que sigue al cursor
    if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      $$<HTMLElement>('[data-tilt]').forEach((el) => {
        el.addEventListener('mousemove', (ev) => {
          const r = el.getBoundingClientRect();
          const x = (ev.clientX - r.left) / r.width - 0.5;
          const y = (ev.clientY - r.top) / r.height - 0.5;
          el.style.transform = `perspective(1200px) rotateY(${x * 5}deg) rotateX(${-y * 4}deg) translateY(-4px)`;
        });
        el.addEventListener('mouseleave', () => (el.style.transform = ''));
      });
      $$<HTMLElement>('[data-spot]').forEach((el) => {
        el.addEventListener('mousemove', (ev) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          el.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });
    }

    // Copiar el email
    $$<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.textContent;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = btn.dataset.copied ?? label;
          setTimeout(() => (btn.textContent = label), 1800);
        } catch {
          location.href = `mailto:${btn.dataset.copy}`;
        }
      });
    });
  </script>
</Base>
