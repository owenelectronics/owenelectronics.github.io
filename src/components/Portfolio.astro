---
import Base from '../layouts/Base.astro';
import { links, suiteResources, type Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const home = t.lang === 'es' ? '/' : '/en/';
const flow = t.method.steps.map((s) => s.title);
const certGallery = t.certs.items.map((c) => ({
  src: `/img/certs/${c.img}.webp`,
  w: c.w,
  h: c.h,
  alt: `${c.title}, ${c.org}`,
  notes: [],
}));
const ch = t.challenge;
---

<Base lang={t.lang} title={t.meta.title} description={t.meta.description}>
  <a class="skip" href="#contenido">{t.a11y.skip}</a>

  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href={home}>Owen Caminos<i>.</i></a>
      <nav class="nav-links" aria-label={t.a11y.menu}>
        <a href="#proyectos">{t.nav.projects}</a>
        <a href="#desafio">{t.nav.challenge}</a>
        <a href="#certificaciones">{t.nav.certs}</a>
        <a href="#experiencia">{t.nav.experience}</a>
      </nav>
      <div class="nav-end">
        <a class="lang" href={t.otherLang.href} title={t.otherLang.title} hreflang={t.otherLang.label.toLowerCase()}>
          {t.otherLang.label}
        </a>
        <a class="btn primary small" href="#contacto">{t.nav.contact}</a>
      </div>
    </div>
  </header>

  <main id="contenido">
    <!-- Portada -->
    <div class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <h1 class="display"><span>Owen</span><span>Caminos</span><span>Dolhartz</span></h1>
            <p class="hero-role">{t.hero.role}<b>{t.hero.focus}</b></p>
            <p class="hero-intro">{t.hero.intro}</p>
            <div class="hero-cta">
              <a class="btn primary" href="#proyectos">
                {t.hero.ctaProjects}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
              </a>
              <a class="btn" href={links.cv} download>{t.hero.ctaCv}</a>
              <a class="icon-link" href={links.github} target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path></svg>
              </a>
              <a class="icon-link" href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3v-11zm6.5 0h3.8v1.5h.06c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76v5.69h-4v-5.04c0-1.2-.02-2.75-1.78-2.75-1.78 0-2.05 1.31-2.05 2.66v5.13h-4v-11z"></path></svg>
              </a>
            </div>
          </div>

          <div class="portrait">
            <img src="/img/owen-retrato.webp" alt={t.hero.photoAlt} width="640" height="800" />
            <dl class="facts mono">
              {
                t.hero.facts.map(([k, v], i) => (
                  <div>
                    <dt>{k}</dt>
                    <dd class={i === 2 ? 'on' : ''}>{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <!-- Suite que se ejecuta de verdad -->
        <section
          class="suite"
          aria-labelledby="suite-title"
          data-suite
          data-resources={JSON.stringify(suiteResources)}
          data-other={t.otherLang.href}
          data-other-lang={t.otherLang.label.toLowerCase()}
          data-strings={JSON.stringify({ rerun: t.suite.rerun, running: t.suite.running, summary: t.suite.summary, viewport: t.suite.viewport })}
        >
          <div class="suite-head">
            <div>
              <h2 class="display" id="suite-title">{t.suite.title}</h2>
              <p>{t.suite.intro}</p>
            </div>
            <button class="btn primary" type="button" data-run>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z"></path></svg>
              <span>{t.suite.run}</span>
            </button>
          </div>
          <ul class="checks">
            {
              t.suite.checks.map((c) => (
                <li class="check" data-check={c.id} data-state="idle">
                  <i class="st" aria-hidden="true" />
                  <span>{c.name}</span>
                  <span class="check-detail mono" />
                </li>
              ))
            }
          </ul>
          <div class="suite-foot mono">
            <span data-summary role="status">{t.suite.idle}</span>
            <span>owenelectronics.github.io{home === '/' ? '' : home}</span>
          </div>
        </section>
      </div>
    </div>

    <!-- Resumen -->
    <section class="tc" id="resumen">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.summary.id}</div>
        <div>
          <h2 class="display">{t.summary.title}</h2>
          <table class="sum">
            <thead>
              <tr>{t.summary.head.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {t.summary.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Qué hago -->
    <section class="tc" id="que-hago">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.profile.id}</div>
        <div>
          <h2 class="display">{t.profile.title}</h2>
          <div class="roles">
            {
              t.profile.rows.map((r) => (
                <div>
                  <h3 class="display">{r.role}</h3>
                  <p>{r.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Proyectos -->
    <section class="tc" id="proyectos">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.projects.id}</div>
        <div>
          <h2 class="display">{t.projects.title}</h2>

          {
            t.projects.items.map((p) => {
              const notes = p.images[0]?.notes.length ?? 0;
              return (
                <article class="proj" id={p.id}>
                  <div class="proj-head">
                    <div>
                      <h3 class="display">{p.title}</h3>
                      <p>{p.subtitle}</p>
                    </div>
                    <span class={`status ${p.wip ? 'wip' : ''}`}>{p.status}</span>
                  </div>

                  <div class="proj-body">
                    {p.images.length > 0 ? (
                      <div data-gallery={JSON.stringify(p.images)}>
                        <button class="viewer-main" type="button" data-open aria-label={`${t.projects.open}: ${p.images[0].alt}`}>
                          <img src={p.images[0].src} alt={p.images[0].alt} width={p.images[0].w} height={p.images[0].h} loading="lazy" decoding="async" />
                          <span class="viewer-tag">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 15v5h-5M4 4l6 6M20 20l-6-6" /></svg>
                            <span data-tag data-base={t.projects.open} data-notes={t.projects.notesLabel}>
                              {t.projects.open}
                              {notes > 0 ? ` · ${notes} ${t.projects.notesLabel}` : ''}
                            </span>
                          </span>
                        </button>
                        {p.images.length > 1 && (
                          <div class="thumbs">
                            {p.images.map((img, i) => (
                              <button type="button" data-thumb={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`${t.a11y.thumb} ${i + 1}: ${img.alt}`}>
                                <img src={img.src} alt="" width={img.w} height={img.h} loading="lazy" decoding="async" />
                              </button>
                            ))}
                          </div>
                        )}
                      </div>
                    ) : (
                      <ol class="flow" aria-label={p.subtitle}>
                        {flow.map((f) => <li>{f}</li>)}
                      </ol>
                    )}

                    <div data-tabs>
                      <div class="tabs" role="tablist" aria-label={p.title}>
                        <button type="button" role="tab" id={`${p.id}-t1`} aria-controls={`${p.id}-p1`} aria-selected="true">{t.projects.tabs.problem}</button>
                        <button type="button" role="tab" id={`${p.id}-t2`} aria-controls={`${p.id}-p2`} aria-selected="false" tabindex="-1">{t.projects.tabs.did}</button>
                        <button type="button" role="tab" id={`${p.id}-t3`} aria-controls={`${p.id}-p3`} aria-selected="false" tabindex="-1">{t.projects.tabs.stack}</button>
                      </div>
                      <div class="panel" role="tabpanel" id={`${p.id}-p1`} aria-labelledby={`${p.id}-t1`}>
                        <p>{p.problem}</p>
                      </div>
                      <div class="panel" role="tabpanel" id={`${p.id}-p2`} aria-labelledby={`${p.id}-t2`} hidden>
                        <ul class="ticks">
                          {p.did.map((d) => <li>{d}</li>)}
                        </ul>
                      </div>
                      <div class="panel" role="tabpanel" id={`${p.id}-p3`} aria-labelledby={`${p.id}-t3`} hidden>
                        <dl class="kv">
                          <dt>{t.projects.roleLabel}</dt>
                          <dd>{p.role}</dd>
                          <dt>Stack</dt>
                          <dd class="stack">{p.stack.join(' · ')}</dd>
                        </dl>
                      </div>
                      {p.links.length > 0 && (
                        <div class="proj-links">
                          {p.links.map((l) => (
                            <a class="btn primary" href={l.href} target="_blank" rel="noopener">
                              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
                              {l.label}
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              );
            })
          }

          <div class="more">
            <h3 class="display">{t.projects.moreTitle}</h3>
            <ul>
              {
                t.projects.more.map((m) => (
                  <li>
                    <div>
                      <b>{m.title}</b>
                      <small>{m.tag}</small>
                    </div>
                    <p>{m.text}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Encontrá el bug -->
    <section class="tc" id="desafio">
      <div class="wrap tc-grid">
        <div class="tc-id">{ch.id}</div>
        <div>
          <h2 class="display">{ch.title}</h2>
          <p class="lead">{ch.intro}</p>

          <div
            class="lab"
            data-lab
            data-strings={JSON.stringify({
              emailOk: ch.emailOk,
              codeApplied: ch.codeApplied,
              codeWrong: ch.codeWrong,
              done: ch.done,
              count: ch.count,
              allFound: ch.allFound,
              pending: ch.pending,
              hints: ch.bugs.map((b) => b.hint),
              titles: ch.bugs.map((b) => b.title),
            })}
          >
            <form class="form" novalidate>
              <h3 class="display">{ch.formTitle}</h3>
              <p class="form-note">{ch.formNote}</p>

              <div class="field">
                <label for="lab-name">{ch.name} <i aria-hidden="true">*</i></label>
                <input id="lab-name" name="name" type="text" autocomplete="off" />
              </div>
              <div class="field">
                <label for="lab-email">{ch.email}</label>
                <input id="lab-email" name="email" type="text" inputmode="email" autocomplete="off" />
                <div class="msg" data-msg="email" aria-live="polite"></div>
              </div>
              <div class="row2">
                <div class="field">
                  <label for="lab-qty">{ch.qty}</label>
                  <input id="lab-qty" name="qty" type="number" value="1" />
                </div>
                <div class="field">
                  <label for="lab-date">{ch.date}</label>
                  <input id="lab-date" name="date" type="date" />
                </div>
              </div>
              <div class="field">
                <label for="lab-code">{ch.code}</label>
                <div class="with-btn">
                  <input id="lab-code" name="code" type="text" placeholder={ch.codeHint} autocomplete="off" />
                  <button class="btn" type="button" data-apply>{ch.apply}</button>
                </div>
                <div class="msg" data-msg="code" aria-live="polite"></div>
              </div>

              <dl class="totals">
                <div>
                  <dt>{ch.unit}</dt>
                  <dd class="mono">$ 12.000</dd>
                </div>
                <div class="big">
                  <dt>{ch.total}</dt>
                  <dd class="mono" data-total>$ 12.000</dd>
                </div>
              </dl>

              <div class="form-actions">
                <button class="btn primary" type="submit">{ch.submit}</button>
                <button class="btn" type="button" data-reset>{ch.reset}</button>
              </div>
              <div class="done" data-done aria-live="polite"></div>
            </form>

            <div>
              <div class="tracker-head">
                <h3 class="display">{ch.tracker}</h3>
                <output class="mono" data-count>{ch.count.replace('{n}', '0')}</output>
              </div>
              <ol>
                {
                  ch.bugs.map((b) => (
                    <li class="bug">
                      <div class="bug-top">
                        <span class="bug-id mono">{b.id}</span>
                        <span class="bug-title">{ch.pending}</span>
                      </div>
                      <div class="bug-body">
                        <div>
                          <dl>
                            <dt>{ch.severity}</dt>
                            <dd>{b.severity}</dd>
                            <dt>{ch.steps}</dt>
                            <dd>{b.steps}</dd>
                            <dt>{ch.expected}</dt>
                            <dd>{b.expected}</dd>
                            <dt>{ch.actual}</dt>
                            <dd>{b.actual}</dd>
                          </dl>
                        </div>
                      </div>
                    </li>
                  ))
                }
              </ol>
              <div class="tracker-foot">
                <button class="btn small" type="button" data-hint>{ch.hint}</button>
                <button class="btn small" type="button" data-reveal>{ch.reveal}</button>
                <div class="hint-text" data-hint-text aria-live="polite"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo trabajo -->
    <section class="tc" id="metodo">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.method.id}</div>
        <div>
          <h2 class="display">{t.method.title}</h2>
          <p class="method-lead display">{t.method.lead}</p>
          <p class="lead" style="margin-top:0">{t.method.intro}</p>
          <ol class="steps">
            {
              t.method.steps.map((s) => (
                <li>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- Certificaciones -->
    <section class="tc" id="certificaciones">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.certs.id}</div>
        <div data-gallery={JSON.stringify(certGallery)}>
          <h2 class="display">{t.certs.title}</h2>
          <p class="studying">
            <span class="status wip">{t.certs.studying.label}</span>
            <b>{t.certs.studying.title}</b>
            <span>{t.certs.studying.org}</span>
          </p>
          {
            t.certs.items.map((c, i) => (
              <article class="cert">
                <button class="cert-thumb" type="button" data-open={i} aria-label={`${t.certs.open}: ${c.title}`}>
                  <img src={`/img/certs/${c.img}-thumb.webp`} alt={`${c.title}, ${c.org}`} width="360" height="270" loading="lazy" decoding="async" />
                </button>
                <div>
                  <h3>{c.title}</h3>
                  <p>{c.org}</p>
                </div>
                <div class="cert-meta">
                  <b>{c.kind}</b>
                  {c.date}
                  {c.extra && <div>{c.extra}</div>}
                </div>
              </article>
            ))
          }
          <div class="other">
            <h3 class="display">{t.certs.otherTitle}</h3>
            <ul>
              {t.certs.other.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Experiencia -->
    <section class="tc" id="experiencia">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.experience.id}</div>
        <div>
          <h2 class="display">{t.experience.title}</h2>
          {
            t.experience.items.map((j) => (
              <article class="job">
                <time class="mono">{j.period}</time>
                <div>
                  <h3 class="display">{j.role}</h3>
                  <p class="job-co">
                    {j.company}. {j.text}
                  </p>
                  <ul class="ticks">
                    {j.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="tc" id="skills">
      <div class="wrap tc-grid">
        <div class="tc-id">{t.skills.id}</div>
        <div>
          <h2 class="display">{t.skills.title}</h2>
          <dl class="skills">
            {
              t.skills.groups.map((g) => (
                <div>
                  <dt>{g.title}</dt>
                  <dd>{g.items}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="contact" id="contacto">
      <div class="wrap">
        <h2 class="display">{t.contact.title}</h2>
        <p>{t.contact.text}</p>
        <a class="contact-mail" href={`mailto:${links.email}`}>{links.email}</a>
        <div class="contact-actions">
          <button class="btn primary" type="button" data-copy={links.email} data-copied={t.contact.copied}>{t.contact.copy}</button>
          <a class="btn" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn" href={links.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href={links.cv} download>{t.contact.cv}</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span>© {new Date().getFullYear()} Owen Caminos Dolhartz</span>    </div>
  </footer>

  <!-- Visor de capturas y certificados -->
  <dialog class="lb" id="lb" aria-label={t.projects.open}>
    <div class="lb-bar">
      <span class="mono" data-lb-count></span>
      <div class="lb-nav">
        <button class="btn small" type="button" data-lb-prev>{t.a11y.prev}</button>
        <button class="btn small" type="button" data-lb-next>{t.a11y.next}</button>
        <button class="btn small" type="button" data-lb-close>{t.a11y.close}</button>
      </div>
    </div>
    <div class="lb-stage" data-lb-stage>
      <figure class="lb-frame" data-lb-frame>
        <img data-lb-img alt="" />
      </figure>
    </div>
    <ol class="lb-notes" data-lb-notes></ol>
  </dialog>

  <script>
    type Shot = { src: string; alt: string; w: number; h: number; notes: { x: number; y: number; text: string }[] };
    const $$ = <T extends Element>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel));
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // ---------- Sección activa en el menú ----------
    const navLinks = $$<HTMLAnchorElement>('.nav-links a');
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) navLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${e.target.id}`));
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    navLinks.forEach((a) => {
      const target = document.querySelector(a.getAttribute('href') ?? '');
      if (target) spy.observe(target);
    });

    // ---------- Suite: verificaciones reales sobre esta página ----------
    const suite = document.querySelector<HTMLElement>('[data-suite]');
    if (suite) {
      const S = JSON.parse(suite.dataset.strings ?? '{}');
      const resources: string[] = JSON.parse(suite.dataset.resources ?? '[]');
      const runBtn = suite.querySelector<HTMLButtonElement>('[data-run]')!;
      const runLabel = runBtn.querySelector('span')!;
      const summary = suite.querySelector<HTMLElement>('[data-summary]')!;

      const hex = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const lum = (h: string) => {
        const n = parseInt(h.replace('#', ''), 16);
        const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
          const s = v / 255;
          return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
        });
        return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
      };
      const ratio = (a: string, b: string) => {
        const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
        return (x + 0.05) / (y + 0.05);
      };

      const checks: Record<string, () => Promise<[boolean, string]>> = {
        anchors: async () => {
          const as = $$<HTMLAnchorElement>('a[href^="#"]').filter((a) => (a.getAttribute('href') ?? '').length > 1);
          const ok = as.filter((a) => document.querySelector(a.getAttribute('href')!)).length;
          return [ok === as.length, `${ok}/${as.length}`];
        },
        resources: async () => {
          const res = await Promise.all(resources.map((u) => fetch(u, { method: 'HEAD', cache: 'no-store' }).then((r) => r.ok).catch(() => false)));
          const ok = res.filter(Boolean).length;
          return [ok === res.length, `${ok}/${res.length}`];
        },
        alt: async () => {
          const imgs = $$<HTMLImageElement>('main img');
          const ok = imgs.filter((i) => i.hasAttribute('alt') && (i.alt.trim().length > 0 || i.closest('[data-thumb]'))).length;
          return [ok === imgs.length, `${ok}/${imgs.length}`];
        },
        contrast: async () => {
          const min = Math.min(ratio(hex('--text'), hex('--bg')), ratio(hex('--muted'), hex('--bg')), ratio(hex('--muted'), hex('--card')), ratio(hex('--acc-ink'), hex('--acc')));
          return [min >= 4.5, `${min.toFixed(1)}:1`];
        },
        lang: async () => {
          const r = await fetch(suite.dataset.other ?? '/', { cache: 'no-store' });
          const html = r.ok ? await r.text() : '';
          const ok = r.ok && html.includes(`lang="${suite.dataset.otherLang}"`);
          return [ok, `HTTP ${r.status}`];
        },
        overflow: async () => {
          const d = document.documentElement;
          return [d.scrollWidth <= d.clientWidth, `${d.clientWidth} px`];
        },
        headings: async () => {
          const hs = $$<HTMLElement>('h1, h2, h3, h4, h5, h6');
          let prev = 0;
          let ok = $$('h1').length === 1;
          for (const h of hs) {
            const level = Number(h.tagName[1]);
            if (prev && level > prev + 1) ok = false;
            prev = level;
          }
          return [ok, `1 h1 · ${hs.length}`];
        },
        load: async () => {
          const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
          const ms = Math.round(nav?.domContentLoadedEventEnd ?? 0);
          return [ms > 0 && ms < 3000, `${ms} ms`];
        },
      };

      const rows = $$<HTMLElement>('[data-check]', suite);
      let busy = false;
      runBtn.addEventListener('click', async () => {
        if (busy) return;
        busy = true;
        runBtn.disabled = true;
        runLabel.textContent = S.running;
        summary.className = '';
        summary.textContent = S.running + '…';
        rows.forEach((r) => {
          r.dataset.state = 'idle';
          r.querySelector('.check-detail')!.textContent = '';
        });
        const t0 = performance.now();
        let pass = 0;
        let fail = 0;
        for (const row of rows) {
          row.dataset.state = 'run';
          let result: [boolean, string];
          try {
            [result] = await Promise.all([checks[row.dataset.check!](), sleep(240)]);
          } catch {
            result = [false, 'error'];
          }
          row.dataset.state = result[0] ? 'pass' : 'fail';
          row.querySelector('.check-detail')!.textContent = result[1];
          result[0] ? pass++ : fail++;
        }
        const ms = Math.round(performance.now() - t0);
        summary.textContent = S.summary.replace('{p}', pass).replace('{f}', fail).replace('{ms}', ms);
        summary.className = fail ? 'ko' : 'ok';
        runLabel.textContent = S.rerun;
        runBtn.disabled = false;
        busy = false;
      });
    }

    // ---------- Pestañas de cada proyecto ----------
    $$<HTMLElement>('[data-tabs]').forEach((box) => {
      const tabs = $$<HTMLButtonElement>('[role="tab"]', box);
      const select = (i: number, focus = false) => {
        tabs.forEach((tab, k) => {
          const on = k === i;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute('aria-controls')!);
          if (panel) panel.hidden = !on;
        });
        if (focus) tabs[i].focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (ev) => {
          if (ev.key === 'ArrowRight') select((i + 1) % tabs.length, true);
          if (ev.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        });
      });
    });

    // ---------- Visor ----------
    const lb = document.querySelector<HTMLDialogElement>('#lb')!;
    const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const lbFrame = lb.querySelector<HTMLElement>('[data-lb-frame]')!;
    const lbNotes = lb.querySelector<HTMLElement>('[data-lb-notes]')!;
    const lbCount = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    let shots: Shot[] = [];
    let at = 0;

    const render = () => {
      const s = shots[at];
      lbImg.src = s.src;
      lbImg.alt = s.alt;
      lbImg.width = s.w;
      lbImg.height = s.h;
      lbCount.textContent = `${at + 1} / ${shots.length} · ${s.alt}`;
      $$('.pin', lbFrame).forEach((p) => p.remove());
      lbNotes.replaceChildren();
      s.notes.forEach((n, i) => {
        const pin = document.createElement('span');
        pin.className = 'pin';
        pin.style.left = `${n.x}%`;
        pin.style.top = `${n.y}%`;
        pin.textContent = String(i + 1);
        pin.setAttribute('aria-hidden', 'true');
        lbFrame.append(pin);
        const li = document.createElement('li');
        const b = document.createElement('b');
        b.textContent = String(i + 1);
        li.append(b, document.createTextNode(n.text));
        lbNotes.append(li);
      });
      const many = shots.length > 1;
      lb.querySelector<HTMLElement>('[data-lb-prev]')!.hidden = !many;
      lb.querySelector<HTMLElement>('[data-lb-next]')!.hidden = !many;
    };
    const step = (d: number) => {
      at = (at + d + shots.length) % shots.length;
      lbFrame.style.animation = 'none';
      void lbFrame.offsetWidth;
      lbFrame.style.animation = '';
      render();
    };
    const openLb = (list: Shot[], i: number) => {
      shots = list;
      at = i;
      render();
      lb.showModal();
    };
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => step(-1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => step(1));
    lb.querySelector('[data-lb-stage]')!.addEventListener('click', (ev) => {
      if (ev.target === ev.currentTarget) lb.close();
    });
    lb.addEventListener('keydown', (ev) => {
      if (shots.length < 2) return;
      if (ev.key === 'ArrowRight') step(1);
      if (ev.key === 'ArrowLeft') step(-1);
    });

    $$<HTMLElement>('[data-gallery]').forEach((g) => {
      const list: Shot[] = JSON.parse(g.dataset.gallery ?? '[]');
      const main = g.querySelector<HTMLButtonElement>('.viewer-main');
      const mainImg = main?.querySelector('img');
      const tag = g.querySelector<HTMLElement>('[data-tag]');
      const thumbs = $$<HTMLButtonElement>('[data-thumb]', g);
      let current = 0;
      thumbs.forEach((th) =>
        th.addEventListener('click', () => {
          current = Number(th.dataset.thumb);
          const s = list[current];
          if (mainImg) {
            mainImg.src = s.src;
            mainImg.alt = s.alt;
          }
          if (tag) tag.textContent = tag.dataset.base + (s.notes.length ? ` · ${s.notes.length} ${tag.dataset.notes}` : '');
          thumbs.forEach((x) => x.setAttribute('aria-current', String(x === th)));
        }),
      );
      $$<HTMLButtonElement>('[data-open]', g).forEach((b) => b.addEventListener('click', () => openLb(list, b.dataset.open ? Number(b.dataset.open) : current)));
    });

    // ---------- Encontrá el bug ----------
    const lab = document.querySelector<HTMLElement>('[data-lab]');
    if (lab) {
      const L = JSON.parse(lab.dataset.strings ?? '{}');
      const form = lab.querySelector('form')!;
      const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
      const msg = (n: string) => lab.querySelector<HTMLElement>(`[data-msg="${n}"]`)!;
      const totalEl = lab.querySelector<HTMLElement>('[data-total]')!;
      const doneEl = lab.querySelector<HTMLElement>('[data-done]')!;
      const countEl = lab.querySelector<HTMLElement>('[data-count]')!;
      const hintEl = lab.querySelector<HTMLElement>('[data-hint-text]')!;
      const bugs = $$<HTMLElement>('.bug', lab);
      const found = new Set<number>();
      const UNIT = 12000;
      let applied = 0;
      const money = (n: number) => (n < 0 ? '-$ ' : '$ ') + Math.abs(Math.round(n)).toLocaleString('es-AR');

      const mark = (i: number) => {
        if (found.has(i)) return;
        found.add(i);
        const el = bugs[i];
        el.classList.add('found', 'fresh');
        el.querySelector('.bug-title')!.textContent = L.titles[i];
        setTimeout(() => el.classList.remove('fresh'), 900);
        countEl.textContent = L.count.replace('{n}', found.size);
        hintEl.textContent = found.size === bugs.length ? L.allFound : '';
      };
      const total = () => {
        const qty = Number(f('qty').value);
        const value = UNIT * qty * (1 - Math.min(applied * 10, 100) / 100);
        totalEl.textContent = money(value);
        if (f('qty').value !== '' && qty < 1) mark(1);
      };

      f('email').addEventListener('blur', () => {
        const v = f('email').value.trim();
        const m = msg('email');
        m.textContent = v ? L.emailOk : '';
        m.className = v ? 'msg ok' : 'msg';
        if (v && !v.includes('@')) mark(0);
      });
      f('qty').addEventListener('input', total);
      f('date').addEventListener('change', () => {
        const v = f('date').value;
        const d = new Date();
        const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        if (v && v < today) mark(4);
      });
      lab.querySelector('[data-apply]')!.addEventListener('click', () => {
        const m = msg('code');
        if (f('code').value.trim().toUpperCase() === 'QA10') {
          applied++;
          m.textContent = L.codeApplied.replace('{n}', Math.min(applied * 10, 100));
          m.className = 'msg ok';
          if (applied >= 2) mark(2);
        } else {
          m.textContent = L.codeWrong;
          m.className = 'msg ko';
        }
        total();
      });
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        if (!f('name').value.trim()) mark(3);
        doneEl.textContent = L.done;
      });
      lab.querySelector('[data-reset]')!.addEventListener('click', () => {
        form.reset();
        applied = 0;
        msg('email').textContent = '';
        msg('code').textContent = '';
        doneEl.textContent = '';
        hintEl.textContent = '';
        found.clear();
        bugs.forEach((b) => {
          b.classList.remove('found', 'fresh');
          b.querySelector('.bug-title')!.textContent = L.pending;
        });
        countEl.textContent = L.count.replace('{n}', 0);
        total();
      });
      lab.querySelector('[data-hint]')!.addEventListener('click', () => {
        const next = bugs.findIndex((_, i) => !found.has(i));
        hintEl.textContent = next === -1 ? L.allFound : L.hints[next];
      });
      lab.querySelector('[data-reveal]')!.addEventListener('click', () => bugs.forEach((_, i) => mark(i)));
    }

    // ---------- Copiar el email ----------
    $$<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.textContent;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.textContent = btn.dataset.copied ?? label;
          setTimeout(() => (btn.textContent = label), 1800);
        } catch {
          location.href = `mailto:${btn.dataset.copy}`;
        }
      });
    });
  </script>
</Base>
